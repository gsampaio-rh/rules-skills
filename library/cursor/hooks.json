{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/harness-context.sh",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": ".cursor/hooks/session-cleanup.sh",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/harness-gate.sh",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/contract-gate.sh",
        "matcher": "Write|StrReplace",
        "timeout": 5,
        "failClosed": true
      },
      {
        "command": ".cursor/hooks/evaluator-guard.sh",
        "matcher": "Write|StrReplace",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "subagentStop": [
      {
        "command": ".cursor/hooks/chain-evaluator.sh",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/pre-commit-harness.sh",
        "matcher": "git commit",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/verify-harness.sh",
        "timeout": 5,
        "loop_limit": 3
      },
      {
        "command": ".cursor/hooks/enforce-progress.sh",
        "timeout": 5,
        "loop_limit": 1
      }
    ]
  }
}
