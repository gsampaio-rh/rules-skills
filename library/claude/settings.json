{
  "outputStyle": "default",
  "permissions": {
    "allow": [
      "Read",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(ls *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/harness-context.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(npm *|yarn *|pnpm *|vite *|next *|flask *|uvicorn *|gunicorn *|cargo run *|go run *|python*http*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/dedup-server.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-harness.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/enforce-progress.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/chain-evaluator.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
