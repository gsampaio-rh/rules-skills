{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/prompt-check.sh",
        "matcher": "UserPromptSubmit",
        "timeout": 3
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/verify-harness.sh",
        "timeout": 5,
        "loop_limit": 2
      }
    ],
    "subagentStop": [
      {
        "command": ".cursor/hooks/chain-evaluator.sh",
        "timeout": 5,
        "loop_limit": 2
      }
    ]
  }
}
