{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/harness-context.sh",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/harness-gate.sh",
        "matcher": "UserPromptSubmit",
        "timeout": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/dedup-server.sh",
        "matcher": "npm|yarn|pnpm|vite|next|flask|uvicorn|gunicorn|cargo run|go run|python.*http",
        "timeout": 5
      },
      {
        "command": ".cursor/hooks/pre-commit-harness.sh",
        "matcher": "git commit",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/verify-harness.sh",
        "timeout": 5,
        "loop_limit": 3
      },
      {
        "command": ".cursor/hooks/enforce-progress.sh",
        "timeout": 5,
        "loop_limit": 2
      },
      {
        "command": ".cursor/hooks/context-health.sh",
        "timeout": 5,
        "loop_limit": 1
      }
    ],
    "subagentStop": [
      {
        "command": ".cursor/hooks/chain-evaluator.sh",
        "timeout": 5,
        "loop_limit": 3
      }
    ]
  }
}
