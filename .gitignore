.DS_Store
.venv/
__pycache__/
tests/eval_results/

# Local IDE config (populated by make setup from library/cursor/)
.cursor/

# Commit approval flag (defense-in-depth; also covered by .cursor/ ignore)
.commit-approved

# File-based harness runtime (state, contract, breadcrumbs, archive) — never commit
.harness/

# Eval repos: .cursor/ (matched above) and .harness/ are runtime artifacts
# generated locally by tests/eval_repos/setup.sh, never committed.
tests/eval_repos/*/.harness/
